{
  "name": "gas-day",
  // Node 22 matches the GitHub Action that builds and deploys the site.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    // Python for the film renderer (film/render.py). Its packages are not installed by default; see README.
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Keep node_modules in a Linux volume so Windows/macOS host installs (and their native binaries) never mix in.
  "mounts": [
    "source=gas-day-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown node:node node_modules && npm ci",
  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Vite dev server", "onAutoForward": "openBrowser" },
    "4173": { "label": "Vite preview (built site)", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "ms-python.python",
        "github.vscode-github-actions"
      ]
    }
  },
  "remoteUser": "node"
}
